{
  "$schema": "https://opencode.ai/config.json",
  "model": "jarvis/jarvis",
  "small_model": "jarvis/jarvis-fast",
  "provider": {
    "jarvis": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Jarvis local",
      "options": {
        "baseURL": "http://jarvis.local:8000/v1/raw"
      },
      "models": {
        "jarvis": {
          "name": "Jarvis — normal (réflexion 3000)",
          "limit": { "context": 32768, "output": 16000 }
        },
        "jarvis-fast": {
          "name": "Jarvis — rapide (sans réflexion)",
          "limit": { "context": 32768, "output": 8000 }
        },
        "jarvis-deep": {
          "name": "Jarvis — approfondi (réflexion 8000)",
          "limit": { "context": 32768, "output": 24000 }
        }
      }
    }
  }
}
