# .env de test — volontairement minimal.
#
# La suite ne doit RIEN emprunter au .env de l'exploitant : ses clés API réelles, ses
# interrupteurs (AGENT_ENABLED, AGENT_SHELL_ENABLED) et ses seuils ajustés à la main
# feraient passer ou échouer les tests selon la machine. Tout ce qui n'est pas posé ici
# retombe donc sur le défaut codé dans config.py — qui est précisément ce qu'on teste.
LLM_LOCAL=yes
