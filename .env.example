# Jarvis — environment configuration
# Copy to .env and fill in your own values: cp .env.example .env
# .env is gitignored — never commit real secrets.
#
# Everything below has a sane default in jarvis-core/src/config.py unless
# marked REQUIRED. You only need to set what your setup actually uses.

# ══════════════════════════════════════════════════════════════════════════
#  LLM providers — full local by default (Apple Silicon)
# ══════════════════════════════════════════════════════════════════════════

# Runs entirely on-device via MLX — no API key needed to get started.
# Requires the mlx / mlx-lm / mlx-vlm packages (already in requirements.txt)
# and the models downloaded once with `python scripts/download_models.py`.
LLM_LOCAL=yes

# ── Pick your models here (optional — sane defaults below work out of the box) ──
# Each line's default is what scripts/download_models.py fetches when unset.
# ROUTER_MODEL_LOCAL=mlx-community/Qwen2.5-1.5B-Instruct-4bit
# PRIMARY_MODEL_LOCAL=spicyneuron/Qwen3.6-35B-A3B-MLX-5.4bit
# REASONING_MODEL_LOCAL=                                        # empty = same as PRIMARY_MODEL_LOCAL
# VISION_MODEL_LOCAL=lmstudio-community/Qwen3-VL-8B-Instruct-MLX-5bit
# HF_TOKEN=                       # only needed to download gated HF models
# HF_HOME=/opt/jarvis/models
# QUANT_KV=no
# QUANT_KV_BITS=4
# LRU_KV_SIZE=4
# LRU_KV_GB=4.0
# LLM_DEBUG_PROMPTS=no

# ── Endpoint /v1/raw — agents de code externes (OpenCode) ────────────────
# Voir DOCS/opencode-local.md. Aucune mémoire, aucun contexte perso injecté.
# Journal dédié : logs/opencode-prompts.log (séparé de prompts.log, gate propre).
# RAW_DEBUG_PROMPTS=true
# Le raisonnement est le principal levier de qualité pour un agent de code.
# RAW_NO_THINK=false
# Borne le raisonnement : à 0, il partagerait RAW_MAX_TOKENS avec la réponse et
# le modèle peut épuiser son budget sans jamais émettre l'appel d'outil.
# RAW_THINKING_BUDGET=3000
# Réflexion + réponse se partagent ce budget.
# RAW_MAX_TOKENS=16000

# ══════════════════════════════════════════════════════════════════════════
#  Cloud LLM providers — optional (set LLM_LOCAL=no to use these instead)
# ══════════════════════════════════════════════════════════════════════════

# Shared fallback credentials — used by router/primary/reasoning/vision tiers
# unless a tier-specific *_API_KEY / *_API_URL / *_MODEL is set below.
# OPENAI_API_KEY=
# OPENAI_API_URL=https://api.openai.com/v1

# ── Per-tier overrides (optional — point each tier at a different provider/model) ──
# ROUTER_MODEL=gpt-4.1-nano
# ROUTER_API_URL=
# ROUTER_API_KEY=
# PRIMARY_MODEL=gpt-4o-mini
# PRIMARY_API_URL=
# PRIMARY_API_KEY=
# REASONING_MODEL=
# REASONING_API_URL=
# REASONING_API_KEY=
# VISION_MODEL=mlx-community/Qwen2.5-VL-7B-Instruct-4bit
# VISION_API_URL=
# VISION_API_KEY=

# ══════════════════════════════════════════════════════════════════════════
#  Google Workspace (Gmail read+send, Calendar read) — optional
# ══════════════════════════════════════════════════════════════════════════
# Create OAuth credentials at console.cloud.google.com, then run
# scripts/generate_google_token.py per user to obtain their refresh token.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALENDAR_ID=primary

# One refresh token per user with "google": true in users_list.json.
# GOOGLE_REFRESH_TOKEN_<CODE>=      # <CODE> = that user's "code" field, uppercased

# ══════════════════════════════════════════════════════════════════════════
#  Apple Push Notifications — optional (push notifications only)
# ══════════════════════════════════════════════════════════════════════════
# Key from developer.apple.com → Certificates, IDs & Profiles → Keys
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=com.yourcompany.JarvisApp
# APNS_KEY_PATH=/opt/jarvis/keys/AuthKey_XXXXXXXXXX.p8
# APNS_ENV=production              # "production" or "sandbox"

# ══════════════════════════════════════════════════════════════════════════
#  Web search — optional
# ══════════════════════════════════════════════════════════════════════════
# Tavily is the primary web search backend; DDG is used as a free fallback
# when unset.
# TAVILY_API_KEY=

# ══════════════════════════════════════════════════════════════════════════
#  Infrastructure (Redis / Qdrant) — defaults match docker-compose.yml
# ══════════════════════════════════════════════════════════════════════════
# REDIS_URL=redis://localhost:6379
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=open-webui_knowledge
# QDRANT_MEMORY_COLLECTION=jarvis_memory
# RAG_TOP_K=8
# RAG_SCORE_THRESHOLD=0.4

# ══════════════════════════════════════════════════════════════════════════
#  Users, data paths
# ══════════════════════════════════════════════════════════════════════════
# List of accounts allowed to use Jarvis. Never commit this file — see
# DOCS/examples/users_list.example.json for the format, then copy it to
# jarvis-core/JarvisData/users_list.json (gitignored) and fill in real
# users. Each user's "code" is their API access secret — generate a random
# string per user, don't reuse the example values.
USERS_LIST=/opt/jarvis/jarvis-core/JarvisData/users_list.json

# SELF_MEMORY_PATH=/opt/jarvis/jarvis-core/JarvisData/jarvis-self.json
# ROUTER_DATA_DIR=/opt/jarvis/RouterData
# TRADE_DATA_DIR=/opt/jarvis/RAGData/Trade

# ══════════════════════════════════════════════════════════════════════════
#  Morning briefing
# ══════════════════════════════════════════════════════════════════════════
# BRIEFING_ENABLED=true
# BRIEFING_TIME=07:30              # HH:MM, local to BRIEFING_TIMEZONE
# BRIEFING_TIMEZONE=Europe/Paris

# ══════════════════════════════════════════════════════════════════════════
#  Open WebUI (used by docker-compose.yml + scripts/uploadrag.py)
# ══════════════════════════════════════════════════════════════════════════
# MAX_UPLOAD_SIZE=5242880
# OPENWEBUI_API_KEY=

# ══════════════════════════════════════════════════════════════════════════
#  LLM token/timing budgets, memory thresholds, background job intervals —
#  all optional, defaults are tuned for a Mac Mini M4 Pro. See the "Variables
#  de contrôle" table in README.md before overriding any of these.
# ══════════════════════════════════════════════════════════════════════════
# TOKEN_SPEED_TPS=50
# TIMEOUT_MARGIN=1.3
# USE_THINKING_BUDGET_PROCESSOR=no
# THINKING_BUDGET_COMPACT=1024
# THINKING_BUDGET_MEDIUM=2048
# THINKING_BUDGET_DEEP=4000
# MAX_TOKENS_TINY=80
# MAX_TOKENS_SHORT=300
# MAX_TOKENS_COMPACT=600
# MAX_TOKENS_MEDIUM=1000
# MAX_TOKENS_NO_THINK=1500
# MAX_TOKENS_BRIEFING=3000
# MAX_TOKENS_SYNTHESIS=8000
# MAX_TOKENS_REASONING=10000
# MAX_TOKENS_HARD_CAP=16000
# HIST_CONV_TOKEN_BUDGET=1000
# SESSION_SUMMARY_TOKENS=600
# HIST_CONV_SUMMARIZE_THRESHOLD=1500
# PROFILE_NARRATIVE_TOKENS=600
# CHAT_MAX_MESSAGES=100
# IOS_MAX_MESSAGES=50
# CHAT_LOG_TTL_DAYS=90
# REFLECTION_INTERVAL_HOURS=6
# CONV_ANALYSIS_INTERVAL_MINUTES=60
# MAX_CHAIN_ITERATIONS=3
# REFINE_PROMPT_THRESHOLD=3
# AUTOBIO_RECENCY_WINDOW_DAYS=365
# EPISODIC_RETENTION_DAYS=45
# AUTOBIO_DEDUP_THRESHOLD=0.82
# MEMORY_DECAY_FACTOR=0.85
# MEMORY_DECAY_THRESHOLD=0.15
# MEMORY_DECAY_DURABLE_MIN=1.0
# MEMORY_CONSOLIDATION_IMPORTANCE=1.0
# DONE_PROJECT_TTL_DAYS=180
# GROWTH_LOG_MAX_ENTRIES=180
