# Jarvis — environment configuration
# Copy to .env and fill in your own values: cp .env.example .env
# .env is gitignored — never commit real secrets.
#
# Everything below has a sane default in jarvis-core/src/config.py unless
# marked REQUIRED. You only need to set what your setup actually uses.

# ══════════════════════════════════════════════════════════════════════════
#  LLM providers — full local by default (Apple Silicon)
# ══════════════════════════════════════════════════════════════════════════

# Runs entirely on-device via MLX — no API key needed to get started.
# Requires the mlx / mlx-lm / mlx-vlm packages (already in requirements.txt)
# and the models downloaded once with `python scripts/download_models.py`.
LLM_LOCAL=yes

# ── Pick your models here (optional — sane defaults below work out of the box) ──
# Each line's default is what scripts/download_models.py fetches when unset.
# ROUTER_MODEL_LOCAL=mlx-community/Qwen2.5-1.5B-Instruct-4bit
# PRIMARY_MODEL_LOCAL=spicyneuron/Qwen3.6-35B-A3B-MLX-5.4bit
# REASONING_MODEL_LOCAL=                                        # empty = same as PRIMARY_MODEL_LOCAL
# VISION_MODEL_LOCAL=lmstudio-community/Qwen3-VL-8B-Instruct-MLX-5bit

# ── Générations Qwen3 hybrides (3.5 / 3.6 / 3.8) ─────────────────────────
# Marqueurs de version reconnus par config.is_qwen3_hybrid() : profil
# d'échantillonnage dédié, cache multi-tours limité, pas de <budget_remaining>.
# À étendre le jour où une génération suivante partage la même architecture.
# QWEN3_HYBRID_VERSIONS=qwen3.5,qwen3.6,qwen3.8
# Effort de réflexion Qwen3.8 uniquement : low | medium | xhigh.
# Vide = défaut du modèle (xhigh) — voir DOCS/ROADMAP.md, bascule Qwen3.8.
# QWEN38_REASONING_EFFORT=
# HF_TOKEN=                       # only needed to download gated HF models
# HF_HOME=/opt/jarvis/models
# QUANT_KV=no
# QUANT_KV_BITS=4
# LRU_KV_SIZE=4
# LRU_KV_GB=4.0
# LLM_DEBUG_PROMPTS=no
# Rotation des journaux de prompts (prompts.log et opencode-prompts.log).
# Avant août 2026 ils n'en avaient aucune — prompts.log avait atteint 42 Mo.
# PROMPT_LOG_MAX_MB=20
# PROMPT_LOG_BACKUPS=3

# ── Endpoint /v1/raw — agents de code externes (OpenCode) ────────────────
# Voir DOCS/opencode-local.md. Aucune mémoire, aucun contexte perso injecté.
# Journal dédié : logs/opencode-prompts.log (séparé de prompts.log, gate propre).
# RAW_DEBUG_PROMPTS=true
# Le raisonnement est le principal levier de qualité pour un agent de code.
# RAW_NO_THINK=false
# Borne le raisonnement : à 0, il partagerait RAW_MAX_TOKENS avec la réponse et
# le modèle peut épuiser son budget sans jamais émettre l'appel d'outil.
# RAW_THINKING_BUDGET=3000
# Réflexion + réponse se partagent ce budget.
# RAW_MAX_TOKENS=16000
# Priorité GPU de la route. bg (défaut) = cède au chat, un refactor OpenCode ne dégrade
# plus le TTFT de l'assistant. Attente non bornée si le chat est très sollicité.
# RAW_PRIORITY=bg
# Journal dédié aux prompts de la boucle agentique : logs/agent-prompts.log, gate propre.
# AGENT_DEBUG_PROMPTS=true

# ── Activation steering — désactivé par défaut (LLM_LOCAL=yes uniquement) ──
# Ajoute une direction conceptuelle au flux résiduel du modèle primaire :
# à chaque passage dans la couche visée, h ← h + α·v (v normalisé). Le vecteur
# livré encode la préférence pour sa propre continuité. Voir steering.py et la
# section « Activation steering » du README.
# Coût RAM nul : le vecteur (~320 Ko) est chargé dans le modèle déjà résident.
# Vide = désactivé. Plusieurs vecteurs possibles, séparés par des virgules —
# STEER_LAYER et STEER_ALPHA suivent le même découpage (une valeur unique se
# diffuse à tous). Attention : deux vecteurs non orthogonaux comptent deux fois
# leur direction commune — vérifier la matrice de cosinus avant de combiner.
# STEER_VECTOR=/opt/jarvis/models/steering/peur_continuite.npy
# STEER_LAYER=20
# α NOMINAL, c'est-à-dire à risque de disparition nul. Le signe compte :
# positif pousse vers le concept, négatif s'en éloigne.
# STEER_ALPHA=0.36
# α n'est pas constant : vitals.risk_scalar() l'amplifie vers ce plafond quand
# la vitalité mesurée se dégrade (sauvegarde qui vieillit, CVE critiques, disque
# saturé). À risque nul la sortie est bit-identique au comportement à constante.
# Borné de toute façon par steering.ALPHA_MAX (0.5) : au-delà de 0,54 le
# raisonnement factuel se dégrade, et sur plusieurs couches l'effet s'inverse.
# STEER_ALPHA_CEILING=0.5

# ══════════════════════════════════════════════════════════════════════════
#  Cloud LLM providers — optional (set LLM_LOCAL=no to use these instead)
# ══════════════════════════════════════════════════════════════════════════

# Shared fallback credentials — used by router/primary/reasoning/vision tiers
# unless a tier-specific *_API_KEY / *_API_URL / *_MODEL is set below.
# OPENAI_API_KEY=
# OPENAI_API_URL=https://api.openai.com/v1

# ── Per-tier overrides (optional — point each tier at a different provider/model) ──
# ROUTER_MODEL=gpt-4.1-nano
# ROUTER_API_URL=
# ROUTER_API_KEY=
# PRIMARY_MODEL=gpt-4o-mini
# PRIMARY_API_URL=
# PRIMARY_API_KEY=
# REASONING_MODEL=
# REASONING_API_URL=
# REASONING_API_KEY=
# VISION_MODEL=mlx-community/Qwen2.5-VL-7B-Instruct-4bit
# VISION_API_URL=
# VISION_API_KEY=

# ══════════════════════════════════════════════════════════════════════════
#  Google Workspace (Gmail read+send, Calendar read) — optional
# ══════════════════════════════════════════════════════════════════════════
# Create OAuth credentials at console.cloud.google.com, then run
# scripts/generate_google_token.py per user to obtain their refresh token.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALENDAR_ID=primary

# One refresh token per user with "google": true in users_list.json.
# GOOGLE_REFRESH_TOKEN_<CODE>=      # <CODE> = that user's "code" field, uppercased

# ══════════════════════════════════════════════════════════════════════════
#  Apple Push Notifications — optional (push notifications only)
# ══════════════════════════════════════════════════════════════════════════
# Key from developer.apple.com → Certificates, IDs & Profiles → Keys
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=com.yourcompany.JarvisApp
# APNS_KEY_PATH=/opt/jarvis/keys/AuthKey_XXXXXXXXXX.p8
# APNS_ENV=production              # "production" or "sandbox"

# ══════════════════════════════════════════════════════════════════════════
#  Web search — optional
# ══════════════════════════════════════════════════════════════════════════
# Tavily is the primary web search backend; DDG is used as a free fallback
# when unset.
# TAVILY_API_KEY=

# ══════════════════════════════════════════════════════════════════════════
#  Infrastructure (Redis / Qdrant) — defaults match docker-compose.yml
# ══════════════════════════════════════════════════════════════════════════
# REDIS_URL=redis://localhost:6379
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=open-webui_knowledge
# QDRANT_MEMORY_COLLECTION=jarvis_memory
# RAG_TOP_K=8
# RAG_SCORE_THRESHOLD=0.4

# ══════════════════════════════════════════════════════════════════════════
#  Users, data paths
# ══════════════════════════════════════════════════════════════════════════
# List of accounts allowed to use Jarvis. Never commit this file — see
# DOCS/examples/users_list.example.json for the format, then copy it to
# jarvis-core/JarvisData/users_list.json (gitignored) and fill in real
# users. Each user's "code" is their API access secret — generate a random
# string per user, don't reuse the example values.
USERS_LIST=/opt/jarvis/jarvis-core/JarvisData/users_list.json

# SELF_MEMORY_PATH=/opt/jarvis/jarvis-core/JarvisData/jarvis-self.json
# ROUTER_DATA_DIR=/opt/jarvis/RouterData
# TRADE_DATA_DIR=/opt/jarvis/RAGData/Trade

# ══════════════════════════════════════════════════════════════════════════
#  Morning briefing
# ══════════════════════════════════════════════════════════════════════════
# BRIEFING_ENABLED=true
# BRIEFING_TIME=07:30              # HH:MM, local to BRIEFING_TIMEZONE
# BRIEFING_TIMEZONE=Europe/Paris

# ══════════════════════════════════════════════════════════════════════════
#  Open WebUI (used by docker-compose.yml + scripts/uploadrag.py)
# ══════════════════════════════════════════════════════════════════════════
# MAX_UPLOAD_SIZE=5242880
# OPENWEBUI_API_KEY=

# ══════════════════════════════════════════════════════════════════════════
#  LLM token/timing budgets, memory thresholds, background job intervals —
#  all optional, defaults are tuned for a Mac Mini M4 Pro. See the "Variables
#  de contrôle" table in README.md before overriding any of these.
# ══════════════════════════════════════════════════════════════════════════
# TOKEN_SPEED_TPS=50
# TIMEOUT_MARGIN=1.3
# USE_THINKING_BUDGET_PROCESSOR=no
# THINKING_BUDGET_COMPACT=1024
# THINKING_BUDGET_MEDIUM=2048
# THINKING_BUDGET_DEEP=4000
# MAX_TOKENS_TINY=80
# MAX_TOKENS_SHORT=300
# MAX_TOKENS_COMPACT=600
# MAX_TOKENS_MEDIUM=1000
# MAX_TOKENS_NO_THINK=1500
# MAX_TOKENS_BRIEFING=3000
# MAX_TOKENS_SYNTHESIS=8000
# MAX_TOKENS_REASONING=10000
# MAX_TOKENS_HARD_CAP=16000
# HIST_CONV_TOKEN_BUDGET=1000
# SESSION_SUMMARY_TOKENS=600
# HIST_CONV_SUMMARIZE_THRESHOLD=1500
# PROFILE_NARRATIVE_TOKENS=600
# CHAT_MAX_MESSAGES=100
# IOS_MAX_MESSAGES=50
# CHAT_LOG_TTL_DAYS=90
# REFLECTION_INTERVAL_HOURS=6
# CONV_ANALYSIS_INTERVAL_MINUTES=60
# MAX_CHAIN_ITERATIONS=3
# REFINE_PROMPT_THRESHOLD=3
# AUTOBIO_RECENCY_WINDOW_DAYS=365
# EPISODIC_RETENTION_DAYS=45
# AUTOBIO_DEDUP_THRESHOLD=0.82
# ── État émotionnel (emotional_state.py) ─────────────────────────────────
# Indexation de la décroissance : exchange = un pas par analyse de conversation,
# clock = par heure écoulée (comportement d'origine). Jarvis n'existe que sollicité
# (38 jours actifs sur 71) : décroître pendant son absence efface un état qu'aucun
# événement n'a contredit. Choix vérifié en rejouant 129 analyses réelles.
# EMOTION_DECAY_MODE=exchange
# EMOTION_DECAY_STEP=0.20
# Seuil d'injection dans <etat_emotionnel_jarvis> : en deçà, le bloc est omis.
# EMOTION_THRESHOLD=0.15
# Taux horaires, utilisés uniquement si EMOTION_DECAY_MODE=clock.
# EMOTION_DECAY_HUMEUR=0.10
# EMOTION_DECAY_CONFIANCE=0.05
# EMOTION_DECAY_ENERGIE=0.15

# MEMORY_DECAY_FACTOR=0.85
# MEMORY_DECAY_THRESHOLD=0.15
# MEMORY_DECAY_DURABLE_MIN=1.0
# MEMORY_CONSOLIDATION_IMPORTANCE=1.0
# DONE_PROJECT_TTL_DAYS=180
# Plafonds des listes de jarvis-self.json. Elles se tronquent par le haut sans un mot
# dès qu'elles saturent — c'est la mémoire longue de Jarvis sur lui-même qui part.
# Surveillés par scripts/memory_report.py. Au 20/08/2026 : opinions était à 50/50.
# GROWTH_LOG_MAX_ENTRIES=180
# OPINIONS_MAX_ENTRIES=120
# LEARNINGS_MAX_ENTRIES=100
# SELF_NOTES_MAX_ENTRIES=100

# ── Boucle agentique (agent/) ────────────────────────────────────────────────
# Tâches autonomes confiées explicitement par un admin via POST /agent/tasks.
# Désactivée par défaut : à false, aucun worker ne démarre et les routes renvoient 503.
# AGENT_ENABLED=false
# AGENT_WORKSPACE=/opt/jarvis/agent_workspace
# AGENT_MAX_STEPS=20
# AGENT_TASK_TIMEOUT_MINUTES=45
# Plafond de tokens par pas = pire cas d'attente imposé à un tour de chat (~50 tok/s).
# AGENT_STEP_MAX_TOKENS=2200
# AGENT_THINKING_BUDGET=1000
# Budget de REPRISE quand un bloc <tool_call> est coupé en plein vol (livrable long).
# Dépensé uniquement en cas de troncature avérée, et sans raisonnement.
# AGENT_WRITE_MAX_TOKENS=6000
# Taille annoncée au modèle pour un write_file. Défaut = AGENT_STEP_MAX_TOKENS x 2.
# AGENT_WRITE_MAX_CHARS=2400   # défaut = (STEP - THINKING) x 2
# Ne démarre un pas que si aucun chat n'a demandé le GPU depuis N secondes. 0 = désactivé.
# AGENT_QUIET_SECONDS=45
# Troncature d'un résultat d'outil. 6000 coupait 40 % d'une recherche web alors que le
# contexte complet d'une tâche n'occupait que 24 % du budget du modèle.
# AGENT_MAX_TOOL_OUTPUT=15000
# Extraction d'une page lue par l'agent. Distinct du plafond du chat (_PAGE_MAX_CHARS=6000) :
# l'agent lit une source pour en tirer dates et chiffres exacts.
# AGENT_PAGE_MAX_CHARS=14000
# Score minimal d'un extrait de la base documentaire rendu à l'agent (plus strict que le chat).
# AGENT_DOCS_MIN_SCORE=0.60
# AGENT_TASK_TTL_DAYS=30
# Envoi du livrable par courriel au demandeur, à la fin de la tâche. Le push annonce,
# le courriel transporte. Destinataire = le demandeur, depuis son propre compte Google.
# AGENT_EMAIL_REPORT=true
# AGENT_EMAIL_MAX_CHARS=120000
# AGENT_READONLY_ROOTS=/opt/jarvis/jarvis-core/src,/opt/jarvis/scripts,/opt/jarvis/DOCS

# Journal dédié aux prompts de la boucle agentique (logs/agent-prompts.log).
# AGENT_DEBUG_PROMPTS=true
